 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Factura Electr\u00f3nica - {{ doc.name }}</title>\n    <style>\n        @page {\n            size: A4;\n            margin: 0;\n        }\n        \n        body {\n            font-family: Arial, sans-serif;\n            font-size: 11px;\n            margin: 15px;\n            padding: 15px;\n            color: rgb(0,0,0);\n            max-width: 210mm;\n            box-sizing: border-box;\n        }\n        \n        /* Encabezado RUC */\n        .header-ruc {\n            text-align: center;\n            border: 2px solid #000;\n            padding: 10px;\n            margin-bottom: 5px;\n            background: #fff;\n        }\n        \n        .ruc-number {\n            font-weight: bold;\n            font-size: 12px;\n        }\n        \n        .factura-title {\n            font-weight: bold;\n            font-size: 12px;\n            margin: 5px 0;\n        }\n        \n        .factura-number {\n            font-size: 14px;\n            font-weight: bold;\n        }\n        \n        /* Encabezado completo en l\u00ednea horizontal */\n        .header-container {\n            display: flex;\n            justify-content: space-between;\n            align-items: flex-start;\n            margin-bottom: 10px;\n        }\n        \n        .company-section {\n            display: flex;\n            align-items: flex-start;\n            flex: 1;\n        }\n        \n        .company-logo {\n            width: 40px;\n            height: 40px;\n            background: #4CAF50;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            font-size: 20px;\n            font-weight: bold;\n            margin-right: 10px;\n            flex-shrink: 0;\n        }\n        \n        .company-info {\n            flex: 1;\n        }\n        \n        .company-name {\n            font-size: 14px;\n            font-weight: bold;\n            margin-bottom: 2px;\n        }\n        \n        .company-subtitle {\n            font-size: 11px;\n            color: #666;\n            margin-bottom: 2px;\n        }\n        \n        .company-address {\n            font-size: 10px;\n        }\n        \n        /* Layout de dos columnas para informaci\u00f3n del cliente */\n        .client-info-container {\n            display: flex;\n            margin: 10px 0;\n        }\n        \n        .client-left-column {\n            width: 50%;\n            padding-right: 20px;\n        }\n        \n        .client-right-column {\n            width: 50%;\n            padding-left: 20px;\n        }\n        \n        /* Filas de informaci\u00f3n */\n        .info-row {\n            display: flex;\n            margin: 3px 0;\n            font-size: 11px;\n            align-items: baseline;\n        }\n        \n        .info-label {\n            font-weight: bold;\n            width: 120px;\n            flex-shrink: 0;\n        }\n        \n        .info-colon {\n            width: 10px;\n            flex-shrink: 0;\n        }\n        \n        .info-value {\n            flex: 1;\n        }\n        \n        /* Tabla de productos */\n        .products-table {\n            width: 100%;\n            height: 40vh;\n            border-collapse: collapse;\n            margin: 8px 0;\n            border: 2px solid #000;\n            table-layout: fixed;\n            display: table;\n        }\n        \n        .products-table thead {\n            display: table-header-group;\n        }\n        \n        .products-table tbody {\n            display: table-row-group;\n            height: 100%;\n        }\n        \n        .products-table tbody tr {\n            display: table-row;\n            height: auto;\n        }\n        \n        .products-table tbody tr.empty-row {\n            height: 100%;\n        }\n        \n        .products-table tbody td {\n            display: table-cell;\n            vertical-align: top;\n            padding: 4px 12px;\n            border-left: 1px solid #ccc;\n            border-right: 1px solid #ccc;\n            font-size: 12px;\n        }\n        \n        .products-table tbody tr.empty-row td {\n            border-bottom: none;\n            height: 100%;\n        }\n        \n        .products-table th {\n            background-color: rgb(0,0,0);\n            color: rgb(255,255,255);\n            font-weight: bold;\n            padding: 8px 12px;\n            text-align: center;\n            font-size: 11px;\n            border-left: 1px solid #ccc;\n            border-right: 1px solid #ccc;\n        }\n        \n        .products-table th:first-child {\n            border-left: none;\n        }\n        \n        .products-table th:last-child {\n            border-right: none;\n        }\n        \n        .products-table td {\n            padding: 4px 12px;\n            border-left: 1px solid #ccc;\n            border-right: 1px solid #ccc;\n            font-size: 12px;\n        }\n        \n        .products-table td.left {\n            text-align: left;\n        }\n        \n        .products-table td.center {\n            text-align: center;\n        }\n        \n        .totals-row {\n            background-color: white;\n        }\n        \n        .total-label {\n            text-align: left;\n            font-weight: bold;\n            background-color: rgb(0,0,0);\n            color: rgb(255,255,255);\n            border-left: 1px solid #000;\n            border-right: 1px solid #000;\n        }\n        \n        .total-value {\n            text-align: right;\n            font-weight: bold;\n            background-color: white;\n            color: black;\n            border-right: 1px solid #000;\n        }\n        \n        /* Contenedor para \"SON:\" y tabla de totales alineados horizontalmente */\n        .amount-totals-container {\n            display: flex;\n            justify-content: space-between;\n            align-items: flex-start;\n            margin-top: 10px;\n        }\n        \n        /* Monto en letras */\n        .amount-words {\n            flex: 1;\n            margin-right: 20px;\n        }\n        \n        .amount-words .label {\n            font-weight: bold;\n            color: #000;\n        }\n        \n        .amount-words .info-colon {\n            margin: 0 5px;\n        }\n        \n        .amount-words .info-value {\n            color: #000;\n        }\n        \n        .totals-table {\n            width: 200px;\n            border-collapse: collapse;\n            border: 2px solid #000;\n            flex-shrink: 0;\n        }\n        \n        .totals-table td {\n            padding: 8px 12px;\n            border-left: 1px solid #000;\n            border-right: 1px solid #000;\n            font-size: 12px;\n        }\n        \n        .products-table td:first-child {\n            border-left: none;\n        }\n        \n        .products-table td:last-child {\n            border-right: none;\n        }\n        \n        .products-table td.right {\n            text-align: right;\n        }\n        \n        .products-table td.center {\n            text-align: center;\n        }\n        \n        /* Caja de totales con estilo correcto */\n        .totals-container {\n            flex: 0 0 auto;\n            margin-left: 20px;\n        }\n        \n        .totals-box {\n            width: 280px;\n            border: 2px solid #000;\n            background: white;\n            display: table;\n            table-layout: fixed;\n        }\n        \n        .total-row {\n            display: table-row;\n        }\n        \n        .total-row .label,\n        .total-row .value {\n            display: table-cell;\n            padding: 12px 18px;\n            font-size: 12px;\n            border-bottom: 1px solid #000;\n            background: rgb(255,255,255);\n            vertical-align: middle;\n        }\n        \n        .total-row .label {\n            text-align: left;\n            border-right: 1px solid #000;\n        }\n        \n        .total-row .value {\n            text-align: right;\n        }\n        \n        .total-row:last-child .label,\n        .total-row:last-child .value {\n            border-bottom: none;\n        }\n        \n        .total-row.header .label,\n        .total-row.header .value {\n            background-color: rgb(0,0,0);\n            color: rgb(255,255,255);\n            font-weight: bold;\n        }\n        \n        .total-row .label {\n            font-weight: bold;\n        }\n        \n        .total-row .value {\n            text-align: right;\n        }\n        \n        .currency-symbol {\n            display: inline;\n        }\n        \n        /* Informaci\u00f3n de pago en layout horizontal */\n        .bottom-section {\n            display: flex;\n            justify-content: space-between;\n            align-items: flex-start;\n            margin: 8px 0;\n        }\n        \n        .payment-container {\n            display: flex;\n            justify-content: space-between;\n            align-items: flex-start;\n            margin: 20px 0;\n        }\n        \n        .payment-info {\n            flex: 1;\n            margin-right: 20px;\n        }\n        \n        .payment-title {\n            font-weight: bold;\n            font-size: 12px;\n            margin: 10px 0;\n        }\n        \n        /* Tabla de cuotas */\n        .installments-table {\n            width: 100%;\n            border-collapse: collapse;\n            margin: 10px 0;\n            border: 2px solid #000;\n            max-width: 400px;\n        }\n        \n        .installments-table th {\n            background-color: rgb(0,0,0);\n            color: rgb(255,255,255);\n            font-weight: bold;\n            padding: 6px 4px;\n            text-align: center;\n            font-size: 10px;\n            border-left: 1px solid #000;\n            border-right: 1px solid #000;\n        }\n        \n        .installments-table th:first-child {\n            border-left: none;\n        }\n        \n        .installments-table th:last-child {\n            border-right: none;\n        }\n        \n        .installments-table td {\n            padding: 6px 4px;\n            border-left: 1px solid #000;\n            border-right: 1px solid #000;\n            font-size: 11px;\n            text-align: center;\n        }\n        \n        .installments-table td:first-child {\n            border-left: none;\n        }\n        \n        .installments-table td:last-child {\n            border-right: none;\n        }\n        \n        /* QR Code centrado */\n        .qr-section {\n            text-align: center;\n            margin: 20px 0;\n        }\n        \n        .qr-code {\n            width: 100px;\n            height: 100px;\n            margin: 10px auto;\n            display: block;\n        }\n        \n        /* Footer */\n        .footer {\n            text-align: center;\n            margin-top: 20px;\n            font-size: 12px;\n        }\n    </style>\n</head>\n<body>\n    {# Obtener informaci\u00f3n de la compa\u00f1\u00eda #}\n    {% set company = frappe.get_doc(\"Company\", doc.company) %}\n    \n    <!-- Encabezado completo en l\u00ednea horizontal -->\n    <div class=\"header-container\">\n        <div class=\"company-section\">\n            <div class=\"company-logo\">{{ company.custom_template_logo_initial or company.name[0] }}</div>\n            <div class=\"company-info\">\n                <div class=\"company-name\">{{ company.custom_sunat_razon_social or company.company_name }}</div>\n                <div class=\"company-subtitle\">{{ company.custom_template_subtitle or \"\" }}</div>\n                <div class=\"company-address\">\n                    {{ company.custom_sunat_direccion_fiscal or \"\" }}\n                </div>\n            </div>\n        </div>\n        \n        <div class=\"header-ruc\">\n            <div class=\"ruc-number\">R.U.C. {{ company.custom_sunat_ruc or \"\" }}</div>\n            <div class=\"factura-title\">FACTURA ELECTR\u00d3NICA</div>\n            <div class=\"factura-number\">{{ doc.name }}</div>\n        </div>\n    </div>\n    \n    <!-- Informaci\u00f3n del cliente en DOS COLUMNAS -->\n    <div class=\"client-info-container\">\n        <div class=\"client-left-column\">\n            <div class=\"info-row\">\n                <span class=\"info-label\">FECHA EMISI\u00d3N</span>\n                <span class=\"info-colon\">:</span>\n                <span class=\"info-value\">{{ frappe.format_date(doc.posting_date, \"dd/MM/yyyy\") if doc.posting_date else \"\" }}</span>\n            </div>\n            \n            <div class=\"info-row\">\n                <span class=\"info-label\">FECHA VENCIMIENTO</span>\n                <span class=\"info-colon\">:</span>\n                <span class=\"info-value\">{{ frappe.format_date(doc.due_date, \"dd/MM/yyyy\") if doc.due_date else \"\" }}</span>\n            </div>\n            \n            <div class=\"info-row\">\n                <span class=\"info-label\">SE\u00d1OR(ES)</span>\n                <span class=\"info-colon\">:</span>\n                <span class=\"info-value\">{{ doc.customer_name or \"\" }}</span>\n            </div>\n            \n            <div class=\"info-row\">\n                <span class=\"info-label\">DIRECCI\u00d3N</span>\n                <span class=\"info-colon\">:</span>\n                <span class=\"info-value\">{{ doc.address_display or \"\" }}</span>\n            </div>\n            \n            <div class=\"info-row\">\n                <span class=\"info-label\">VENDEDOR</span>\n                <span class=\"info-colon\">:</span>\n                <span class=\"info-value\">{{ company.company_name or \"\" }}</span>\n            </div>\n            \n            <div class=\"info-row\">\n                <span class=\"info-label\">OBSERVACI\u00d3N</span>\n                <span class=\"info-colon\">:</span>\n                <span class=\"info-value\">{{ doc.custom_template_observacion or \"\" }}</span>\n            </div>\n        </div>\n        \n        <div class=\"client-right-column\">\n            <div class=\"info-row\">\n                <span class=\"info-label\">R.U.C</span>\n                <span class=\"info-colon\">:</span>\n                <span class=\"info-value\">{{ doc.tax_id or \"\" }}</span>\n            </div>\n            \n            <div class=\"info-row\">\n                <span class=\"info-label\">GU\u00cdA DE REMISI\u00d3N</span>\n                <span class=\"info-colon\">:</span>\n                <span class=\"info-value\">{{ doc.custom_template_guia_remision or \"\" }}</span>\n            </div>\n            \n            <div class=\"info-row\">\n                <span class=\"info-label\">ORDEN DE COMPRA</span>\n                <span class=\"info-colon\">:</span>\n                <span class=\"info-value\">{{ doc.po_no or \"\" }}</span>\n            </div>\n            \n            <div class=\"info-row\">\n                <span class=\"info-label\">MONEDA</span>\n                <span class=\"info-colon\">:</span>\n                <span class=\"info-value\">{{ \"DOLARES\" if doc.currency == \"USD\" else \"SOLES\" }}</span>\n            </div>\n        </div>\n    </div>\n    \n    <!-- Tabla de productos -->\n    <table class=\"products-table\">\n        <thead>\n            <tr>\n                <th>CANT (KG)</th>\n                <th>DESCRIPCION</th>\n                <th>P. UNIT</th>\n                <th>DSCT.</th>\n                <th>TOTAL</th>\n            </tr>\n        </thead>\n        <tbody>\n            {# Iterar sobre los items del documento #}\n            {% for item in doc.items %}\n            <tr>\n                <td class=\"right\">{{ \"%.2f\"|format(item.qty) }}</td>\n                <td>{{ item.item_name or item.item_code }}</td>\n                <td class=\"right\">{{ \"%.2f\"|format(item.rate) }}</td>\n                <td class=\"right\">{{ \"%.5f\"|format(item.discount_percentage) }}%</td>\n                <td class=\"right\">{{ \"%.2f\"|format(item.amount) }}</td>\n            </tr>\n            {% endfor %}\n            \n            {# Fila vac\u00eda para ocupar el espacio restante #}\n            <tr class=\"empty-row\">\n                <td>&nbsp;</td>\n                <td>&nbsp;</td>\n                <td>&nbsp;</td>\n                <td>&nbsp;</td>\n                <td>&nbsp;</td>\n            </tr>\n        </tbody>\n    </table>\n    \n    <!-- Contenedor para \"SON:\" y tabla de totales alineados horizontalmente -->\n    <div class=\"amount-totals-container\">\n        <!-- Monto en letras a la izquierda -->\n        <div class=\"amount-words\">\n            <span class=\"label\"> SON</span>\n            <span class=\"info-colon\">:</span>\n            <span class=\"info-value\">{{ doc.in_words|upper|replace(\"PEN \", \"\")|replace(\"SOLO\", \"SOLES\") }}</span>\n        </div>\n        \n        <!-- Tabla de totales a la derecha -->\n        <table class=\"totals-table\">\n            <tbody>\n                <tr>\n                    <td class=\"total-label\">SUB TOTAL</td>\n                    <td class=\"total-value\">{{ doc.currency }} {{ frappe.utils.fmt_money(doc.net_total, currency=doc.currency) }}</td>\n                </tr>\n                <tr>\n                    <td class=\"total-label\">IGV. 18%</td>\n                    <td class=\"total-value\">{{ doc.currency }} {{ frappe.utils.fmt_money(doc.total_taxes_and_charges, currency=doc.currency) }}</td>\n                </tr>\n                <tr>\n                    <td class=\"total-label\">TOTAL</td>\n                    <td class=\"total-value\">{{ doc.currency }} {{ frappe.utils.fmt_money(doc.grand_total, currency=doc.currency) }}</td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n    \n    <!-- Layout horizontal: Informaci\u00f3n de cuotas a la izquierda -->\n    <div class=\"bottom-section\">\n        <!-- Informaci\u00f3n de cuotas (izquierda) -->\n        <div class=\"payment-info\">\n            <div class=\"info-row\">\n                <span class=\"info-label\">CONDICION DE PAGO</span>\n                <span class=\"info-colon\">:</span>\n                <span class=\"info-value\">{{ doc.custom_template_condicion_pago or \"CONTADO\" }}</span>\n            </div>\n            \n            <div class=\"payment-title\">INFORMACI\u00d3N DE CUOTAS :</div>\n            \n            <div class=\"info-row\">\n                <span class=\"info-label\">Monto Neto Pendiente de Pago</span>\n                <span class=\"info-colon\">:</span>\n                <span class=\"info-value\">{{ doc.currency }} {{ frappe.utils.fmt_money(doc.outstanding_amount, currency=doc.currency) if doc.outstanding_amount else \"0.00\" }}</span>\n            </div>\n            \n            <div class=\"info-row\">\n                <span class=\"info-label\">Total de Cuotas</span>\n                <span class=\"info-colon\">:</span>\n                <span class=\"info-value\">{{ doc.payment_schedule|length if doc.payment_schedule else \"0\" }}</span>\n            </div>\n            \n            <!-- Tabla de cuotas -->\n            <table class=\"installments-table\">\n                <thead>\n                    <tr>\n                        <th>NRO. DE<br>CUOTA</th>\n                        <th>FECHA<br>VENCIMIENTO</th>\n                        <th>MONTO DE<br>CUOTA</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    {% if doc.payment_schedule %}\n                        {% for payment in doc.payment_schedule %}\n                    <tr>\n                        <td>{{ loop.index }}</td>\n                        <td>{{ frappe.format_date(payment.due_date, \"dd/MM/yyyy\") if payment.due_date else \"\" }}</td>\n                        <td>{{ frappe.utils.fmt_money(payment.payment_amount, currency=doc.currency) }}</td>\n                    </tr>\n                        {% endfor %}\n                    {% else %}\n                    <tr>\n                        <td>&nbsp;</td>\n                        <td>&nbsp;</td>\n                        <td>&nbsp;</td>\n                    </tr>\n                    {% endif %}\n                </tbody>\n            </table>\n        </div>\n        \n        <!-- Espacio para QR code -->\n        <div class=\"qr-section\">\n            <!-- QR Code real del original -->\n            <div class=\"qr-code\">\n                {% if doc.custom_sunat_qr_code %}\n                <img src=\"{{ doc.custom_sunat_qr_code }}\" alt=\"QR Code\" style=\"width: 100px; height: 100px;\">\n                {% else %}\n                <div style=\"width: 100px; height: 100px; background: #f0f0f0; border: 1px solid #ccc; display: flex; align-items: center; justify-content: center; font-size: 10px; color: #666;\">\n                    QR CODE\n                </div>\n                {% endif %}\n            </div>\n        </div>\n    </div>\n    \n    <!-- Footer -->\n    <div class=\"footer\">\n        Representacion Impresa de la Factura Electronica\n    </div>\n</body>\n</html>\n",
